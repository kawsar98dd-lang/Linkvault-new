# ---- BnlinkVault Phase 2 environment (example only; NEVER commit real values) ----
NODE_ENV=development
APP_URL=http://localhost:3000
# Comma-separated additional trusted origins (exact origins, no wildcards)
TRUSTED_ORIGINS=

# Runtime database role (app_rw, NOBYPASSRLS). Used by the web app.
DATABASE_URL=postgres://app_rw:CHANGE_ME@localhost:5432/bnlinkvault
# Migration role (app_migrator). Used ONLY by `pnpm db:migrate` / CI. Never deploy to runtime.
MIGRATOR_DATABASE_URL=postgres://app_migrator:CHANGE_ME@localhost:5432/bnlinkvault
# Admin URL used ONLY by `pnpm db:provision` (creates roles). Never deploy to runtime.
ADMIN_DATABASE_URL=postgres://postgres:CHANGE_ME@localhost:5432/bnlinkvault
# Role passwords consumed by db:provision
APP_RW_PASSWORD=CHANGE_ME
APP_MIGRATOR_PASSWORD=CHANGE_ME

# >= 32 random bytes each (e.g. `openssl rand -base64 48`). Different values per secret.
BETTER_AUTH_SECRET=
CSRF_SECRET=

# Google OAuth (optional; both or neither)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Turnstile (optional). TURNSTILE_MODE: off | on | risk
TURNSTILE_MODE=off
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Email (Postmark). If unset, a console mailer is used in development ONLY.
POSTMARK_SERVER_TOKEN=
EMAIL_FROM=BnlinkVault <no-reply@example.invalid>

# Observability (optional)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
LOG_LEVEL=info
